# ============================================================
#  SOUKELKOM — PRODUCTION ENVIRONMENT TEMPLATE
#  Copy to .env BEFORE deploying. Never ship a local .env.
# ============================================================

APP_NAME="SOUKELKOM"
APP_ENV=production
# CRITICAL: switching to true leaks credentials, stack traces, env secrets to visitors.
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Generate fresh:  php artisan key:generate
APP_KEY=

APP_CIPHER=AES-256-CBC

# ---- Database (MySQL 8 / MariaDB in production) ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=soukelkom
DB_USERNAME=soukelkom
DB_PASSWORD=CHANGE_ME

# ---- Session / cache / queue (Redis recommended at scale) ----
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=your-domain.com
# HARDENING: cookies only over HTTPS + strict same-site
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=strict

CACHE_STORE=redis
CACHE_PREFIX=soukelkom

# Production queue = redis; run: php artisan horizon
QUEUE_CONNECTION=redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---- Mail (use your real SMTP provider; never log in production) ----
MAIL_MAILER=smtp
MAIL_HOST=smtp.your-provider.com
MAIL_PORT=587
MAIL_USERNAME=your-sending-user
MAIL_PASSWORD=your-sending-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=support@soukelkom.test
MAIL_FROM_NAME="SOUKELKOM"

# ---- Search (Meilisearch for production) ----
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=masterKey

# ---- Payments ----
# Stripe Connect keys (production). Leave empty to hide card checkout.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# ---- Reverse proxy / CDN ----
# '*' = trust all proxies (Cloudflare, nginx, LB). Restrict if possible.
TRUSTED_PROXIES=*

# ---- Admin email for order notifications ----
MAIL_ADMIN_ADDRESS=you@your-domain.com